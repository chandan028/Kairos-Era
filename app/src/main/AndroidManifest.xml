<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Minimal permissions. There is deliberately NO internet permission: the app cannot send data anywhere.
        POST_NOTIFICATIONS: asked only when the user wants reminders.
        SCHEDULE_EXACT_ALARM: user-granted special access for on-time task reminders; reminders still work
        (possibly a few minutes late) without it.
        RECEIVE_BOOT_COMPLETED: rebuild the reminder schedule after a restart.
        USE_BIOMETRIC / USE_FINGERPRINT (merged from androidx.biometric): the optional app lock. Android does the
        check; the app never receives biometric data.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- ACTIVITY_RECOGNITION: optional, for Winter Arc steps from the phone's own step counter. Asked only when the person turns it on. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />

    <application
        android:name=".KairosApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:resizeableActivity="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Kairos"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:theme="@style/Theme.Kairos.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Our own alarms and notification actions only; never reachable from other apps. -->
        <receiver
            android:name=".core.notifications.ReminderReceiver"
            android:exported="false" />

        <!-- Winter Arc reminders: our own alarms only. -->
        <receiver
            android:name=".feature.winterarc.ArcReminderReceiver"
            android:exported="false" />

        <!-- System broadcasts after which reminders are rebuilt from the database. Actions are validated in code. -->
        <receiver
            android:name=".core.notifications.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widgets. Not exported: the launcher binds them through the system, and no other app can call them. -->
        <receiver
            android:name=".feature.widgets.MotivationWidget"
            android:exported="false"
            android:label="@string/widget_motivation_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_motivation_info" />
        </receiver>

        <receiver
            android:name=".feature.widgets.TasksWidget"
            android:exported="false"
            android:label="@string/widget_tasks_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tasks_info" />
        </receiver>

        <receiver
            android:name=".feature.widgets.ProgressWidget"
            android:exported="false"
            android:label="@string/widget_progress_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_progress_info" />
        </receiver>

        <receiver
            android:name=".feature.widgets.QuickAddWidget"
            android:exported="false"
            android:label="@string/widget_quick_add_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_add_info" />
        </receiver>

        <!-- Winter Arc widgets (same rules as above: not exported, bound by the launcher). -->
        <receiver
            android:name=".feature.widgets.ArcDayWidget"
            android:exported="false"
            android:label="@string/wa_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_arc_info" />
        </receiver>
        <receiver
            android:name=".feature.widgets.ArcHabitsWidget"
            android:exported="false"
            android:label="@string/wa_widget_large_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_arc_large_info" />
        </receiver>
        <receiver
            android:name=".feature.widgets.ArcQuoteWidget"
            android:exported="false"
            android:label="@string/wa_widget_quote_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_arc_quote_info" />
        </receiver>
        <receiver
            android:name=".feature.widgets.ArcClockWidget"
            android:exported="false"
            android:label="@string/wa_widget_clock_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_arc_clock_info" />
        </receiver>
        <receiver
            android:name=".feature.widgets.ArcWaterWidget"
            android:exported="false"
            android:label="@string/wa_widget_water_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_arc_water_info" />
        </receiver>
        <receiver
            android:name=".feature.widgets.ArcStepsWidget"
            android:exported="false"
            android:label="@string/wa_widget_steps_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_arc_steps_info" />
        </receiver>
        <receiver
            android:name=".feature.widgets.ArcStudyWidget"
            android:exported="false"
            android:label="@string/wa_widget_study_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_arc_study_info" />
        </receiver>
        <receiver
            android:name=".feature.widgets.ArcCalendarWidget"
            android:exported="false"
            android:label="@string/wa_widget_calendar_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_arc_calendar_info" />
        </receiver>
        <receiver
            android:name=".feature.widgets.ArcSpeakWidget"
            android:exported="false"
            android:label="@string/wa_widget_speak_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_arc_speak_info" />
        </receiver>
        <receiver
            android:name=".feature.widgets.ArcBookWidget"
            android:exported="false"
            android:label="@string/wa_widget_book_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_arc_book_info" />
        </receiver>
        <receiver
            android:name=".feature.widgets.ArcStreakWidget"
            android:exported="false"
            android:label="@string/wa_widget_week_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_arc_week_info" />
        </receiver>
        <receiver android:name=".feature.widgets.ArcWidgetReceiver" android:exported="false" />
        <!-- Checkbox taps from the Today's Tasks widget; only our own PendingIntents reach it. -->
        <receiver
            android:name=".feature.widgets.WidgetActionReceiver"
            android:exported="false" />

        <!-- Persists the per-app language choice on Android 12 and below (AppCompat). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
