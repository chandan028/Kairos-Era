<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:fontFamily="serif" android:text="@string/widget_progress_title" android:textColor="@color/widget_ink" android:textSize="18sp" />
        <TextView android:id="@+id/overall" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="serif" android:textColor="@color/widget_green" android:textSize="18sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row_tasks" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/label_tasks" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="@color/widget_ink" android:textSize="13sp" />
            <TextView android:id="@+id/value_tasks" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/widget_green" android:textSize="13sp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/bar_tasks" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp"
            android:layout_marginTop="5dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_progress_green" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row_study" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/label_study" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="@color/widget_ink" android:textSize="13sp" />
            <TextView android:id="@+id/value_study" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/widget_purple" android:textSize="13sp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/bar_study" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp"
            android:layout_marginTop="5dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_progress_purple" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row_reading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/label_reading" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="@color/widget_ink" android:textSize="13sp" />
            <TextView android:id="@+id/value_reading" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/widget_amber" android:textSize="13sp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/bar_reading" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp"
            android:layout_marginTop="5dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_progress_amber" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row_fitness" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/label_fitness" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="@color/widget_ink" android:textSize="13sp" />
            <TextView android:id="@+id/value_fitness" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/widget_coral" android:textSize="13sp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/bar_fitness" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp"
            android:layout_marginTop="5dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_progress_coral" />
    </LinearLayout>
    <TextView android:id="@+id/footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:fontFamily="serif" android:textStyle="italic" android:text="@string/widget_keep_going" android:textColor="@color/widget_muted" android:textSize="14sp" />
</LinearLayout>
